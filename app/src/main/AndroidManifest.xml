<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- INTERNET is used only by the opt-in update check (update package, docs/UPDATES.md): one HTTPS GET to
         api.github.com from the foreground UI. The archive never leaves the device. Library-merged permissions we never
         use are stripped here and the build fails (verifyPermissions*) if anything outside the allowlist appears in the
         merged manifest. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Opt-in "messages saved" notifications only; off by default and requested at runtime on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <!-- UI: lists launchable apps (labels/icons) in the per-app exclusion picker. Launcher intent only, never
         QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- System settings screens we deep-link to (notification access, battery optimization). -->
        <intent>
            <action android:name="android.settings.ACTION_NOTIFICATION_LISTENER_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.NOTIFICATION_LISTENER_DETAIL_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.IGNORE_BATTERY_OPTIMIZATION_SETTINGS" />
        </intent>
    </queries>

    <application
        android:name=".UnsendVaultApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.UnsendVault"
        android:enableOnBackInvokedCallback="true"
        android:localeConfig="@xml/locales_config"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="37">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Notification access: enabled only when the user explicitly grants it in system settings. -->
        <service
            android:name=".capture.VaultNotificationListener"
            android:exported="true"
            android:label="@string/listener_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <!-- Ongoing notifications (media, navigation, downloads) never carry messages. Silent ones are kept:
                 muted chats/groups post silently. -->
            <meta-data
                android:name="android.service.notification.disabled_filter_types"
                android:value="ongoing" />
        </service>

        <!-- WorkManager is initialized on demand (UnsendVaultApp implements Configuration.Provider), so a cold start for
             the notification listener does not open WorkManager's database or reconcile jobs. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Glance only needs WorkManager's normal scheduling, never a foreground service. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />

        <!-- WIDGET RECEIVERS (owned by the widget layer) -->
        <!-- Glance widgets. Exported so the launcher/system can deliver APPWIDGET_* broadcasts; they only re-render.
             updatePeriodMillis is 0 in every provider: refresh is event-driven (WidgetModule.startSync). -->
        <receiver
            android:name=".widget.ArchiveCountWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_count_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_count_info" />
        </receiver>
        <receiver
            android:name=".widget.RecentWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_recent_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_recent_info" />
        </receiver>
        <receiver
            android:name=".widget.FavoritesWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_favorites_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_favorites_info" />
        </receiver>
        <receiver
            android:name=".widget.AppSummaryWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_apps_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_apps_info" />
        </receiver>
        <receiver
            android:name=".widget.CaptureControlWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_capture_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_capture_info" />
        </receiver>
    </application>
</manifest>
